PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/inventory_db
JWT_SECRET=change_me
JWT_EXPIRE=1h

ADMIN_EMAIL=you@email.com
COMPANY_NAME=Our Company
COMPANY_EMAIL=you@email.com

# Brevo (recommended) — https://www.brevo.com → SMTP & API → SMTP key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=you@email.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Our Company <you@email.com>"

# Or Gmail (needs App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Our Company <you@gmail.com>"

EMAIL_TEST_MODE=false
